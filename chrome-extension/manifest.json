{
  "manifest_version": 3,
  "name": "Web Search Neo Companion",
  "version": "1.3.7",
  "description": "Lets the local Web Search Neo MCP control tabs in your already-open Chrome.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "debugger",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/slime-16.png",
    "32": "icons/slime-32.png",
    "48": "icons/slime-48.png",
    "128": "icons/slime-128.png"
  },
  "action": {
    "default_title": "Web Search Neo Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/slime-16.png",
      "32": "icons/slime-32.png",
      "48": "icons/slime-48.png",
      "128": "icons/slime-128.png"
    }
  }
}

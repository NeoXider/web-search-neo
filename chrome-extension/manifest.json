{
  "manifest_version": 3,
  "name": "Web Search Neo Companion",
  "version": "1.2.0",
  "description": "Lets the local Web Search Neo MCP control tabs in your already-open Chrome.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Web Search Neo Companion"
  }
}
